# =================================================================
# MEDBRIDGE - Environment Configuration Template
# Generative AI Clash Hackathon 2026 @ Techno India University
# RED ZONE_DevOps & Quantum_Neurons
# =================================================================

# Google Gemini API Key (Multimodal Vision & Packaging OCR Extraction)
# Optional in demo mode: When omitted, MedBridge automatically uses
# high-fidelity simulated packaging OCR extraction with full clinical reviews.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Authentication & Cloud Firestore)
# Optional in demo mode: The app provides seamless localStorage persistence
# and reactive concurrency holds for zero-setup judging evaluation.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=medbridge-kolkata.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medbridge-kolkata
VITE_FIREBASE_STORAGE_BUCKET=medbridge-kolkata.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google Maps / Places API (Optional - Leaflet & OpenStreetMap are active by default)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

